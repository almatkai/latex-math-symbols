[package]
name = "latex-beta-sdk-fixture"
version = "0.0.0"
edition = "2021"
rust-version = "1.85"
publish = false
[dependencies]
serde = { version = "=1.0.219", features = ["derive"] }
serde_json = "=1.0.140"
tokio = { version = "=1.45.1", features = ["rt-multi-thread", "macros", "sync", "time"] }
tempfile = "=3.20.0"
log = "=0.4.27"
