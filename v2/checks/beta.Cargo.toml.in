[package]
name = "latex-beta-fixture"
version = "0.0.0"
edition = "2021"
rust-version = "1.85"
publish = false
[lib]
test = false
doctest = false
[dependencies]
latex-math-symbols-native = { path = "../../.." }
latex-beta-sdk-fixture = { path = "../sdk" }
serde = { version = "=1.0.219", features = ["derive"] }
serde_json = "=1.0.140"
tokio = { version = "=1.45.1", features = ["rt-multi-thread", "macros", "sync", "time"] }
uuid = { version = "=1.16.0", features = ["v4"] }
log = "=0.4.27"
